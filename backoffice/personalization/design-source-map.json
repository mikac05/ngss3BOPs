      "y": 2827,
      "text": "电竞"
    },
    {
      "id": "147:7047",
      "x": 495,
      "y": 2827,
      "text": "彩票"
    },
    {
      "id": "147:8460",
      "x": 2495,
      "y": 658,
      "text": "样式一 / 架構一樣\n但配色方式不同"
    },
    {
      "id": "147:8719",
      "x": 980,
      "y": 939,
      "text": "架構與現有的版面有類似的，\n但樣式配色上的差異，可以做出層次感"
    },
    {
      "id": "147:8720",
      "x": 758,
      "y": 2537,
      "text": "有前後景的3D旋轉效果的切換場遊戲類型"
    },
    {
      "id": "147:8721",
      "x": 448,
      "y": 3025,
      "text": "篩選區可進行不同的篩選配置 >"
    },
    {
      "id": "147:8722",
      "x": 984,
      "y": 3816,
      "text": "原本的樣式3"
    },
    {
      "id": "147:8723",
      "x": 2495,
      "y": 618,
      "text": "原本的樣式1下去優化調整"
    },
    {
      "id": "147:8725",
      "x": 2499,
      "y": 2193,
      "text": "样式二 / 點擊後以目前從上方haeder向下展開的方式展開，\n及出現彈窗來呈現"
    },
    {
      "id": "147:8802",
      "x": 2499,
      "y": 3690,
      "text": "样式三 / 仿印度版樣式"
    },
    {
      "id": "147:8851",
      "x": 2499,
      "y": 5123,
      "text": "样式四 / 將懸浮規劃在\n上方headerg上"
    },
    {
      "id": "147:8943",
      "x": 2929,
      "y": 5476,
      "text": "滑動示意，項目ICON下方有一層底色"
    },
    {
      "id": "147:8944",
      "x": 2499,
      "y": 7940,
      "text": "样式五 / 樣式4的延伸，\n變成左右"
    },
