  "constraints": [
    {
      "id": "topDownloadBar-app-download",
      "condition": "topDownloadBar is set to OFF while App download capability is available",
      "action": "disable or hide OFF option on topDownloadBar switch",
      "protectedEntry": "App download bar and download FAB"
    },
    {
      "id": "vipCard-vip-reachability",
      "condition": "vipCard is set to '隐藏VIP资讯' while neither bottomNav nor alternateButton hosts VIP",
      "action": "disable '隐藏VIP资讯' option in vipCard editor",
      "protectedEntry": "VIP entry surface"
    },
    {
      "id": "shortcuts-sidebar-host",
      "condition": "shortcuts is set to '侧边栏内' while sidebar is '关闭'",
      "action": "disable '侧边栏内' option when sidebar is OFF; disable closing sidebar when shortcuts are inside sidebar",
      "protectedEntry": "Shortcuts entry surface"
    },
    {
      "id": "compact-header-statusbar-shortcut",
      "condition": "shortcuts is set to '状态列按钮' while topStatusBar is '简洁'",
      "action": "mutually disable '简洁' topStatusBar when shortcuts are '状态列按钮', and vice-versa",
      "protectedEntry": "Withdrawal / status-bar action reachability"
    },
    {
      "id": "bottomNav-capabilities-reachability",
      "condition": "A bottomNav slot edit zeroes the last remaining surface of a core CAPABILITIES item",
      "action": "disable removing or reassigning that slot",
      "protectedEntry": "Sole remaining capability surface"
    },
    {
      "id": "alternateButton-target-selection",
      "condition": "alternateButton mode is SET without an explicit target selected",
      "action": "disable SET toggle until a target capability is chosen, or auto-default target to first available capability",
      "protectedEntry": "Alternate button target integrity"
    }
  ],
